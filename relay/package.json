{
  "name": "dashboardz-relay",
  "version": "1.0.0",
  "description": "WebSocket relay for remote Dashboardz hubs and senders",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../scripts/check-typecheck-scope.mjs && tsc -p tsconfig.check.json",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": ["dashboardz", "relay", "websocket", "notifications", "self-hosted"],
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
