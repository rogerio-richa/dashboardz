{
  "name": "dashboardz-hub",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm --prefix admin run build",
    "typecheck": "node ../scripts/check-typecheck-scope.mjs && tsc -p tsconfig.check.json"
  },
  "keywords": ["dashboardz", "self-hosted", "notifications", "dashboard", "websocket"],
  "license": "AGPL-3.0-only",
  "description": "Self-hosted Dashboardz hub for alerts, screens, and widgets",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "node-ical": "0.27.6",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
