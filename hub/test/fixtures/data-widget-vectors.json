{
  "_readme": [
    "Browser test vectors for the shared data-widget core.",
    "hub/test/layout-core.test.ts runs this exact file as the browser vector contract.",
    "The former Android/Compose twin was retired; change a rule -> change this implementation and",
    "the vectors together, never a vector alone to match a convenient result.",
    "Conventions: JSON cannot hold `undefined`. A vector whose expected result is `undefined`",
    "carries \"expect\": null PLUS \"expectMissing\": true; a vector expecting a real JSON null",
    "carries \"expect\": null with NO expectMissing flag. Every number here was derived by hand",
    "from the contract arithmetic - never from a program's output."
  ],
  "resolvePath": [
    {
      "name": "empty path resolves to the whole payload",
      "payload": {
        "a": 1,
        "b": {
          "c": 2
        }
      },
      "path": "",
      "expect": {
        "a": 1,
        "b": {
          "c": 2
        }
      }
    },
    {
      "name": "empty path on an array payload",
      "payload": [
        1,
        2
      ],
      "path": "",
      "expect": [
        1,
        2
      ]
    },
    {
      "name": "single object key",
      "payload": {
        "cpu": 37.2
      },
      "path": "cpu",
      "expect": 37.2
    },
    {
      "name": "nested object",
      "payload": {
        "a": {
          "b": {
            "c": 42
          }
        }
      },
      "path": "a.b.c",
      "expect": 42
    },
    {
      "name": "object leaf is returned whole",
      "payload": {
        "a": {
          "b": {
            "c": 1
          }
        }
      },
      "path": "a.b",
      "expect": {
        "c": 1
      }
    },
    {
      "name": "array index",
      "payload": {
        "a": {
          "b": [
            10,
            20
          ]
        }
      },
      "path": "a.b.1",
      "expect": 20
    },
    {
      "name": "array index at the root",
      "payload": [
        10,
        20,
        30
      ],
      "path": "2",
      "expect": 30
    },
    {
      "name": "index 0 then key",
      "payload": {
        "rows": [
          {
            "v": 1
          },
          {
            "v": 2
          }
        ]
      },
      "path": "rows.0.v",
      "expect": 1
    },
    {
      "name": "nested arrays",
      "payload": {
        "a": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      },
      "path": "a.1.0",
      "expect": 3
    },
    {
      "name": "digits as an OBJECT key (not an index)",
      "payload": {
        "0": "x"
      },
      "path": "0",
      "expect": "x"
    },
    {
      "name": "falsy leaf 0 is a hit, not a miss",
      "payload": {
        "a": {
          "b": 0
        }
      },
      "path": "a.b",
      "expect": 0
    },
    {
      "name": "boolean leaf",
      "payload": {
        "ok": true
      },
      "path": "ok",
      "expect": true
    },
    {
      "name": "leaf holding JSON null resolves TO null (not missing)",
      "payload": {
        "a": null
      },
      "path": "a",
      "expect": null
    },
    {
      "name": "array index out of range -> missing",
      "payload": {
        "a": [
          10,
          20
        ]
      },
      "path": "a.5",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "non-digit segment on an array -> missing (arrays accept numeric indexes only)",
      "payload": [
        10,
        20
      ],
      "path": "length",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "negative index is not all-digits -> missing",
      "payload": [
        10,
        20
      ],
      "path": "-1",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "miss mid-path -> missing",
      "payload": {
        "a": {
          "b": 1
        }
      },
      "path": "a.z.c",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "traversing INTO a non-object leaf -> missing",
      "payload": {
        "a": 5
      },
      "path": "a.b",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "scalar payload with a non-empty path -> missing",
      "payload": 5,
      "path": "a",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "null payload with a non-empty path -> missing",
      "payload": null,
      "path": "a",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "inherited keys are not own keys -> missing",
      "payload": {},
      "path": "toString",
      "expect": null,
      "expectMissing": true
    },
    {
      "name": "malformed leading-dot path never throws -> missing",
      "payload": {
        "a": 1
      },
      "path": ".a",
      "expect": null,
      "expectMissing": true
    }
  ],
  "displayValue": [
    {
      "name": "integral number renders with no decimal point",
      "value": 5,
      "format": "raw",
      "decimals": null,
      "expect": "5"
    },
    {
      "name": "5.0 in the payload is still integral",
      "value": 5.0,
      "format": "raw",
      "decimals": null,
      "expect": "5"
    },
    {
      "name": "integral beats an explicit decimals (5 never 5.0)",
      "value": 5,
      "format": "raw",
      "decimals": 2,
      "expect": "5"
    },
    {
      "name": "zero",
      "value": 0,
      "format": "raw",
      "decimals": null,
      "expect": "0"
    },
    {
      "name": "negative integral",
      "value": -12,
      "format": "raw",
      "decimals": null,
      "expect": "-12"
    },
    {
      "name": "float, no decimals set -> String(v)",
      "value": 37.2,
      "format": "raw",
      "decimals": null,
      "expect": "37.2"
    },
    {
      "name": "float with decimals 1 -> fixed",
      "value": 37.246,
      "format": "raw",
      "decimals": 1,
      "expect": "37.2"
    },
    {
      "name": "float with decimals 2 -> fixed, rounds up",
      "value": 37.246,
      "format": "raw",
      "decimals": 2,
      "expect": "37.25"
    },
    {
      "name": "decimals 0 rounds half AWAY from zero",
      "value": 2.5,
      "format": "raw",
      "decimals": 0,
      "expect": "3"
    },
    {
      "name": "decimals 0 rounds half away from zero (negative)",
      "value": -2.5,
      "format": "raw",
      "decimals": 0,
      "expect": "-3"
    },
    {
      "name": "a negative that rounds to zero KEEPS its sign (toFixed splits the sign off first)",
      "value": -0.04,
      "format": "raw",
      "decimals": 1,
      "expect": "-0.0"
    },
    {
      "name": "negative rounding to zero at decimals 0 -> '-0', not '0'",
      "value": -0.4,
      "format": "raw",
      "decimals": 0,
      "expect": "-0"
    },
    {
      "name": "negative rounding to zero at decimals 2 -> '-0.00'",
      "value": -0.004,
      "format": "raw",
      "decimals": 2,
      "expect": "-0.00"
    },
    {
      "name": "format null means raw",
      "value": 42,
      "format": null,
      "decimals": null,
      "expect": "42"
    },
    {
      "name": "string passes through untouched",
      "value": "hello",
      "format": "raw",
      "decimals": null,
      "expect": "hello"
    },
    {
      "name": "empty string passes through",
      "value": "",
      "format": "raw",
      "decimals": null,
      "expect": ""
    },
    {
      "name": "type dispatch beats format: a numeric STRING is not abbreviated",
      "value": "1500",
      "format": "abbrev",
      "decimals": null,
      "expect": "1500"
    },
    {
      "name": "boolean true",
      "value": true,
      "format": "raw",
      "decimals": null,
      "expect": "true"
    },
    {
      "name": "boolean false",
      "value": false,
      "format": "raw",
      "decimals": null,
      "expect": "false"
    },
    {
      "name": "null -> em dash placeholder",
      "value": null,
      "format": "raw",
      "decimals": null,
      "expect": "—"
    },
    {
      "name": "null -> em dash placeholder under abbrev too",
      "value": null,
      "format": "abbrev",
      "decimals": 2,
      "expect": "—"
    },
    {
      "name": "object -> compact single-line JSON, no spaces",
      "value": {
        "a": 1,
        "b": [
          2,
          3
        ]
      },
      "format": "raw",
      "decimals": null,
      "expect": "{\"a\":1,\"b\":[2,3]}"
    },
    {
      "name": "array -> compact single-line JSON",
      "value": [
        1,
        "x",
        null
      ],
      "format": "raw",
      "decimals": null,
      "expect": "[1,\"x\",null]"
    },
    {
      "name": "empty object",
      "value": {},
      "format": "raw",
      "decimals": null,
      "expect": "{}"
    },
    {
      "name": "abbrev K",
      "value": 1500,
      "format": "abbrev",
      "decimals": null,
      "expect": "1.5K"
    },
    {
      "name": "abbrev at the exact K boundary - NO zero stripping",
      "value": 1000,
      "format": "abbrev",
      "decimals": null,
      "expect": "1.0K"
    },
    {
      "name": "abbrev just below the K boundary falls back to the raw rule",
      "value": 999,
      "format": "abbrev",
      "decimals": null,
      "expect": "999"
    },
    {
      "name": "abbrev below the boundary, non-integral, no decimals",
      "value": 999.5,
      "format": "abbrev",
      "decimals": null,
      "expect": "999.5"
    },
    {
      "name": "abbrev negative below the boundary uses |v| for the tier test",
      "value": -999,
      "format": "abbrev",
      "decimals": null,
      "expect": "-999"
    },
    {
      "name": "abbrev zero",
      "value": 0,
      "format": "abbrev",
      "decimals": null,
      "expect": "0"
    },
    {
      "name": "abbrev M at the exact boundary",
      "value": 1000000,
      "format": "abbrev",
      "decimals": null,
      "expect": "1.0M"
    },
    {
      "name": "abbrev negative M (tier from |v|, sign kept)",
      "value": -2500000,
      "format": "abbrev",
      "decimals": null,
      "expect": "-2.5M"
    },
    {
      "name": "abbrev B at the exact boundary",
      "value": 1000000000,
      "format": "abbrev",
      "decimals": null,
      "expect": "1.0B"
    },
    {
      "name": "abbrev B with default 1 decimal",
      "value": 1234567890,
      "format": "abbrev",
      "decimals": null,
      "expect": "1.2B"
    },
    {
      "name": "abbrev B honours decimals",
      "value": 1234567890,
      "format": "abbrev",
      "decimals": 2,
      "expect": "1.23B"
    },
    {
      "name": "abbrev K honours decimals 2",
      "value": 1536,
      "format": "abbrev",
      "decimals": 2,
      "expect": "1.54K"
    },
    {
      "name": "abbrev K with decimals 0 rounds",
      "value": 1500,
      "format": "abbrev",
      "decimals": 0,
      "expect": "2K"
    },
    {
      "name": "no tier above B - trillions stay in B",
      "value": 1500000000000,
      "format": "abbrev",
      "decimals": null,
      "expect": "1500.0B"
    }
  ],
  "applyScale": [
    {
      "name": "identity",
      "px": 96,
      "scale": 1,
      "floor": 16,
      "expect": 96
    },
    {
      "name": "null scale means 1",
      "px": 24,
      "scale": null,
      "floor": 10,
      "expect": 24
    },
    {
      "name": "clamped high: 3 is treated as SCALE_MAX 2",
      "px": 96,
      "scale": 3,
      "floor": 16,
      "expect": 192
    },
    {
      "name": "SCALE_MAX exactly",
      "px": 96,
      "scale": 2,
      "floor": 16,
      "expect": 192
    },
    {
      "name": "clamped low: 0.1 is treated as SCALE_MIN 0.5",
      "px": 96,
      "scale": 0.1,
      "floor": 16,
      "expect": 48
    },
    {
      "name": "SCALE_MIN exactly",
      "px": 96,
      "scale": 0.5,
      "floor": 16,
      "expect": 48
    },
    {
      "name": "negative scale clamps to SCALE_MIN",
      "px": 120,
      "scale": -4,
      "floor": 16,
      "expect": 60
    },
    {
      "name": "floor wins: FLOOR_VALUE holds the primary value size",
      "px": 16,
      "scale": 0.5,
      "floor": 16,
      "expect": 16
    },
    {
      "name": "floor wins for labels",
      "px": 12,
      "scale": 0.5,
      "floor": 10,
      "expect": 10
    },
    {
      "name": "rounds half up (10.5 -> 11, so NOT half-even; 10 would mean floor/trunc)",
      "px": 14,
      "scale": 0.75,
      "floor": 10,
      "expect": 11
    },
    {
      "name": "rounds .5 up again (55.5 -> 56)",
      "px": 37,
      "scale": 1.5,
      "floor": 16,
      "expect": 56
    },
    {
      "name": "rounds DOWN below .5 with no floor masking it: 15*0.75 = 11.25 exactly -> 11 (ceil would give 12)",
      "px": 15,
      "scale": 0.75,
      "floor": 10,
      "expect": 11
    },
    {
      "name": "rounds DOWN against the FLOOR_VALUE floor too: 15*1.75 = 26.25 exactly -> 26 (ceil would give 27)",
      "px": 15,
      "scale": 1.75,
      "floor": 16,
      "expect": 26
    },
    {
      "name": "rounds DOWN on a non-exact product far from any tie: 24*0.55 = 13.200000000000001 -> 13 (ceil would give 14)",
      "px": 24,
      "scale": 0.55,
      "floor": 10,
      "expect": 13
    },
    {
      "name": "the floor wins over the rounded product: 12*0.6 = 7.199... -> 7, lifted to the floor 10",
      "px": 12,
      "scale": 0.6,
      "floor": 10,
      "expect": 10
    },
    {
      "name": "quadrant label at 1.25",
      "px": 48,
      "scale": 1.25,
      "floor": 16,
      "expect": 60
    },
    {
      "name": "at the floor with scale 2",
      "px": 10,
      "scale": 2,
      "floor": 10,
      "expect": 20
    }
  ],
