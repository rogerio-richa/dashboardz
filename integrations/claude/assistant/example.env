# dashboardz-assistant — copy to .env (or export in launchd plist) and fill in.
DASHBOARDZ_HUB_URL=http://hub.example.lan:8484
DASHBOARDZ_SENDER_TOKEN=dbz_s_...   # Senders tab (shown once)
DASHBOARDZ_AGENT_TOKEN=dbz_a_...    # Agents tab (shown once) — for MCP sessions
ANTHROPIC_API_KEY=sk-ant-...        # REQUIRED for `run` sessions; Agent SDK is API-key-only
# ASSISTANT_DEVICES=dev_...          # default alert targets; falls back to the sender's default devices
# ASSISTANT_ADHERENCE_FEED=feed_...  # stream feed for reminder outcomes (create on Data sources page)
# ASSISTANT_TICK_MS=30000
# ASSISTANT_DATA_DIR=~/.config/dashboardz-assistant
# DASHBOARDZ_MCP=/path/to/clients/mcp/dist/cli.js
